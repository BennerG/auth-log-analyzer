# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_log_analyzer?sslmode=disable

# Auth
API_KEY=dev-secret-key-change-in-prod

# Redis (for rate limiting)
REDIS_URL=redis://localhost:6379
RATE_LIMIT_INGEST=30
RATE_LIMIT_EVENTS=120
RATE_LIMIT_ANALYSIS=30
